{
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "{app,data/index}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/mandi",
      "schedule": "30 0 * * *"
    }
  ]
}
